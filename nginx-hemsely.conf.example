# Perfect Production Nginx Configuration for Hemsely (hemsely.com)
# Place this file in /etc/nginx/sites-available/hemsely and link to /etc/nginx/sites-enabled/

# 1. HTTP → HTTPS Automatic Redirect
server {
    listen 80;
    listen [::]:80;
    server_name hemsely.com www.hemsely.com;

    return 301 https://$host$request_uri;
}

# 2. HTTPS Main Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name hemsely.com www.hemsely.com;

    # Global Max Upload Payload Limit (Required for profile photos & selfies)
    client_max_body_size 50M;

    # SSL Certificates (Managed by Certbot / Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/hemsely.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hemsely.com/privkey.pem;

    # Frontend Static Build Location (Update if your dist folder is at /var/www/html or /var/www/hemsely/frontend/dist)
    root /var/www/html;
    index index.html;

    # SPA Routing (React Router Support)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 1. API Proxy to Node.js Backend (Port 5000)
    # IMPORTANT: DO NOT add a trailing slash after 5000! (e.g. http://127.0.0.1:5000)
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. Uploaded Images & Media Files Proxy
    # IMPORTANT: DO NOT add a trailing slash after 5000! (e.g. http://127.0.0.1:5000)
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }

    # 3. Socket.io WebSockets & HTTP Polling Proxy (Real-Time Chat & Notifications)
    location /socket.io/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
