# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Firebase Web config (from Firebase Console > Project Settings > General > Your apps)
# These are public client identifiers, not secrets - Firebase access is controlled by
# Security Rules / App Check / authorized domains, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Cloud Messaging Web Push certificate (VAPID) public key
# (Firebase Console > Project Settings > Cloud Messaging > Web configuration)
VITE_FIREBASE_VAPID_KEY=
